# Copy this file to .env (or export these as real environment variables)
# and fill in real values before running against anything other than a
# throwaway local database. Nothing here has a real secret checked in -
# the defaults in application.yml are local-dev-only placeholders.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/arstore
DB_USERNAME=arstore
DB_PASSWORD=arstore

# --- JWT ---
# Must be at least 32 characters (256 bits) for HS256.
JWT_SECRET=change-me-to-a-long-random-string-in-every-real-environment
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=ar-store

# --- SMTP / outgoing mail ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
MAIL_FROM=no-reply@arstore.local

# --- Google reCAPTCHA v2 ---
# Get real keys from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
# Set to false only in local dev if you don't have a real reCAPTCHA secret yet.
RECAPTCHA_ENABLED=true

# --- CORS / frontend ---
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Server ---
SERVER_PORT=8080

# --- Seeding (only used when the "seed" profile is active) ---
# Defaults to the bundled classpath:seed/products.xml; override with a
# file: URL only if you want to seed from a different XML file.
#SEED_PRODUCTS_XML_PATH=classpath:seed/products.xml
